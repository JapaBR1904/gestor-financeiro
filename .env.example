# PostgreSQL usado pelo backend Spring Boot.
# Nunca coloque senhas ou chaves reais neste arquivo do GitHub.
DB_URL=jdbc:postgresql://localhost:5432/nexo
DB_USERNAME=nexo_app
DB_PASSWORD=

# Origem do frontend autorizada a usar cookies da API.
NEXO_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Somente desenvolvimento. Em producao, deixe false e libere planos apenas pelo pagamento/webhook.
SAAS_PROTOTYPE_PLAN_SWITCH=true

# Nexo IA
GEMINI_API_KEY=

# E-mail de autenticacao
MAIL_ENABLED=false
MAIL_FROM=no-reply@nexo.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false

# Checkout simulado: exige perfil dev/test; prod/production nunca usam o simulador.
PAGAMENTO_SIMULADO_ENABLED=false
