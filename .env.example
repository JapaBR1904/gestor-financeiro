# PostgreSQL usado pelo backend Spring Boot.
# Nunca coloque senhas ou chaves reais neste arquivo do GitHub.
DB_URL=jdbc:postgresql://localhost:5432/nexo
DB_USERNAME=nexo_app
DB_PASSWORD=

# Origem do frontend autorizada a usar cookies da API.
NEXO_ALLOWED_ORIGINS=http://localhost:3000
# Origem do frontend utilizada nos links de convite; HTTPS em produção.
NEXO_FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Somente desenvolvimento. Em producao, deixe false e libere planos apenas pelo pagamento/webhook.
SAAS_PROTOTYPE_PLAN_SWITCH=true

# Nexo IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Transporte recomendado. Configure a chave somente no processo/secret manager.
NEXO_EMAIL_PROVIDER=resend
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Somente diagnostico manual dev/test; nao e usado pela recuperacao.
NEXO_RESEND_DIAGNOSTIC_TO=

# SMTP legado: utilizado somente com NEXO_EMAIL_PROVIDER=smtp.
MAIL_ENABLED=false
MAIL_FROM=no-reply@nexo.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false

# Desenvolvimento: dev habilita o checkout simulado por padrão.
SPRING_PROFILES_ACTIVE=dev
# Descomente somente para desligar a simulação local; prod/production sempre bloqueiam.
# PAGAMENTO_SIMULADO_ENABLED=false

# Cadastro local direto: dev usa OFF por padrão; para testar código por e-mail:
# NEXO_EMAIL_VERIFICATION_ENABLED=true
# Em prod/production, OFF é recusado no startup.
